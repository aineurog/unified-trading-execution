# Demo is the default integration environment. Set BINANCE_TESTNET=true and
# BINANCE_DEMO=false to select Testnet instead. Never use production keys here.

# Binance Demo Trading credentials.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=
BINANCE_TESTNET=false
BINANCE_DEMO=true

# Binance Spot/Futures Testnet credentials (alternative to Demo Trading).
# BINANCE_TESTNET_API_KEY=
# BINANCE_TESTNET_API_SECRET=
# BINANCE_TESTNET=true
# BINANCE_DEMO=false
# BINANCE_SPOT_TESTNET_API_KEY=
# BINANCE_SPOT_TESTNET_API_SECRET=
# BINANCE_USDM_TESTNET_API_KEY=
# BINANCE_USDM_TESTNET_API_SECRET=
# BINANCE_COINM_TESTNET_API_KEY=
# BINANCE_COINM_TESTNET_API_SECRET=

# Binance mainnet credentials (live trading; use only when explicitly intended).
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_TESTNET=false
# BINANCE_DEMO=false
