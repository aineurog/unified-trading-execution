# Hyperliquid testnet credentials — copy to .env and fill in your keys.
# Do NOT commit real keys.  The integration conftest reads these env vars
# and skips all integration tests if they are not set.
#
# The address is the API wallet address (0x...); the private key is the
# API wallet's signing key.  Testnet only — integration tests never touch
# mainnet.
HYPERLIQUID_TESTNET_ADDRESS=
HYPERLIQUID_TESTNET_PRIVATE_KEY=
